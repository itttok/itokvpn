port: 7890
socks-port: 7891
redir-port: 7892
mixed-port: 7893
tproxy-port: 7895
ipv6: false
mode: rule
log-level: silent
allow-lan: true
external-controller: 0.0.0.0:9090
secret: DWD
bind-address: "*"
unified-delay: true
profile:
  store-selected: true
dns:
  enable: true
  ipv6: false
  enhanced-mode: redir-host
  listen: 0.0.0.0:7874
  nameserver:
    - 1.1.1.1
    - 8.8.8.8
    - 112.215.203.254
    - 112.215.198.248
    - 112.215.198.254
    - 112.215.203.248
  fallback:
    - 1.0.0.1
    - https://dns.cloudflare.com/dns-query
    - https://dns.google/dns-query
    - 112.215.203.254
    - 112.215.198.248
    - 112.215.198.254
    - 112.215.203.248
  default-nameserver:
    - 1.1.1.1
    - 8.8.8.8
    - 112.215.198.248
    - 112.215.198.254
    - 112.215.203.248
    - 112.215.203.254
proxies:
- name: 05.oktober.gens
  type: vless
  server: 13.249.231.85
  port: 443
  uuid: 146d3dd2-a7d7-41ce-92f2-c7a0f558fd47
  udp: true
  tls: true
  network: ws
  client-fingerprint: chrome
  servername: d11dymj6ul901r.cloudfront.net
  alpn:
   - http/1.1
  skip-cert-verify: true
  ws-opts:
    path: "/vless-ws/" 
    headers:
      Host: d11dymj6ul901r.cloudfront.net
proxy-groups:
  - name: GLOBAL
    type: select
    proxies:
      - FALLBACK
  - name: URL-TEST
    type: url-test
    strategy: consistent-hashing
    disable-udp: true
    proxies:
      - 05.oktober.gens
    url: http://www.gstatic.com/generate_204
    interval: '10'
    tolerance: '15'
  - name: LOAD-BALANCE
    type: load-balance
    strategy: round-robin
    disable-udp: false
    proxies:
      - 05.oktober.gens
    url: http://www.gstatic.com/generate_204
    interval: '10'
  - name: SELECT
    type: select
    proxies:
      - 05.oktober.gens
  - name: FALLBACK
    type: fallback
    disable-udp: true
    proxies:
      - 05.oktober.gens
    url: http://www.youtube.com/generate_204
    interval: '100'
rules:
  - MATCH,GLOBAL
